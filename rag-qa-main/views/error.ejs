<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Something went wrong · Document Q&A</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body class="landing-page">
    <main class="upload-card error-card">
      <div class="brand-mark error-mark">!</div>
      <h1>We couldn’t process that</h1>
      <p><%= message %></p>
      <a class="button-link" href="/">Return to upload</a>
    </main>
  </body>
</html>
